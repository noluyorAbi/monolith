# Optional. Without it the public contributions calendar is scraped instead,
# which works fine but is rate limited by GitHub rather than by your token.
GITHUB_TOKEN=

# Where this is deployed. Drives canonical urls, the sitemap and OG images.
NEXT_PUBLIC_SITE_URL=

# Where the source lives, if you fork it.
NEXT_PUBLIC_PROJECT_URL=

# The private launch board at /admin. Leave this empty and the route answers
# 404: no login form, no panel, nothing to guess at. Set it and that password
# is the only way in, so make it long. Changing it invalidates every session.
ADMIN_PASSWORD=

# Where the launch board saves. With a Vercel Blob token it writes a private
# blob; without one it writes .data/launch.json, which is already gitignored.
# `vercel blob store add` creates the store and sets this for you.
BLOB_READ_WRITE_TOKEN=
